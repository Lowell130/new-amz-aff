# Copia questo file in .env e compila i valori. NON committare mai il file .env.

APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=INFO

# memory = nessun MongoDB necessario (dati demo in RAM) | mongo = MongoDB reale
DATA_BACKEND=memory
MONGO_URI=mongodb://localhost:27017
MONGO_DB=product_discovery
SEED_DEMO_ON_STARTUP=true

# mock = prezzi finti deterministici | amazon = Creators API (Fase 11, non ancora implementato)
PRODUCT_PROVIDER=mock
PROVIDER_CACHE_TTL_HOURS=24

# Il tuo tag affiliato (es. nomesito-21). Senza tag i link non sono tracciati.
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=it
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=

# none | openai | gemini (usato dall'AI Advisor, Fase 8)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Origini frontend ammesse, separate da virgola
CORS_ORIGINS=http://localhost:3000
# Token per /api/admin/* (header X-Admin-Token). Genera una stringa lunga e casuale.
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=120
